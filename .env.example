# Docker Compose 使用的本地开发数据库配置。
POSTGRES_DB=monitor_platform
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor_dev_password
POSTGRES_PORT=5432

# Go 服务和集成测试使用的连接字符串。
DATABASE_URL=postgres://monitor:monitor_dev_password@localhost:5432/monitor_platform?sslmode=disable

# Docker Compose 使用的本地 ClickHouse 配置。
CLICKHOUSE_USER=monitor
CLICKHOUSE_PASSWORD=monitor_dev_password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Go 服务和集成测试通过原生协议连接 ClickHouse。
CLICKHOUSE_DSN=clickhouse://monitor:monitor_dev_password@localhost:9000/monitor_platform?dial_timeout=5s&compress=lz4

# Redis 只保存可过期的服务端 Session，不保存用户与事件业务数据。
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Go duration 格式；默认登录有效期为 7 天。
SESSION_TTL=168h
