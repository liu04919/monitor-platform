# 仅填写域名，不要包含 https:// 或路径。
MONITOR_API_DOMAIN=api.example.com

# 使用十六进制随机密码，避免连接 URL 还需要额外转义。
# 可在服务器执行三次：openssl rand -hex 32
POSTGRES_DB=monitor_platform
POSTGRES_USER=monitor
POSTGRES_PASSWORD=replace_with_random_hex

CLICKHOUSE_DB=monitor_platform
CLICKHOUSE_USER=monitor
CLICKHOUSE_PASSWORD=replace_with_random_hex

REDIS_PASSWORD=replace_with_random_hex

# Go duration 格式；默认登录有效期为 7 天。
SESSION_TTL=168h

# 可选镜像标签。发布新版本时可以改成 Git commit SHA。
IMAGE_TAG=latest
